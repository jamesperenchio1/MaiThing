{
  "expo": {
    "name": "MaiThing",
    "slug": "maithing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maithing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jamyangperenchio.maithing",
      "newArchEnabled": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow MaiThing to use your location to show nearby merchants and listings.",
        "NSPhotoLibraryUsageDescription": "Allow MaiThing to access your photos to upload listing images.",
        "NSPhotoLibraryAddUsageDescription": "Allow MaiThing to save images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jamyangperenchio.maithing",
      "newArchEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-calendar",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MaiThing to access your camera to scan customer pickup QR codes.",
          "microphonePermission": "Allow MaiThing to access your microphone.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAIHna_1PKSUKp1ElZwSh6SlV-7O8Kv6K8",
          "iosGoogleMapsApiKey": "AIzaSyDhCeOSbBZ9ZRmeTfUqKtAma60Rh2bXhpc"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70293565-7df3-4f07-848f-7e0cbf2f11a0"
      }
    },
    "owner": "jamyangperenchio"
  }
}
