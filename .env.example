# Copy to .env.local and fill in with your own Supabase project's values.

# Supabase project URL and anon (publishable) key.
# Find these in your Supabase project's Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to 'supabase' to talk to the real backend above. Any other value
# (or unset) falls back to the in-memory mock repositories in
# src/repositories/mock.ts, so the app runs with no backend configured.
EXPO_PUBLIC_REPOSITORY_MODE=mock
